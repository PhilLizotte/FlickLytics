# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.TmdbSearchController.index()
GET     /finances/:movieId          controllers.TmdbSearchController.finances(movieId: Int)
GET     /api/search                 controllers.TmdbSearchController.search(category: String, query: String)
GET     /reviews/:kind/:id/:title   controllers.TmdbSearchController.reviewDetails(kind: String, id: Int, title: String) 

GET     /person/:id/known-for       controllers.TmdbSearchController.knownFor(id: Integer)
GET     /api/movie                  controllers.TmdbSearchController.searchMovieById(id: Int)

GET     /diversity/:category/:id    controllers.TmdbSearchController.globalDiversity(category: String, id: Integer)

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

GET     /movie/:id                  controllers.TmdbSearchController.movieDetails(id: Integer)
GET     /tv/:id                     controllers.TmdbSearchController.tvDetails(id: Integer)

GET     /ws                         controllers.TmdbSearchController.ws